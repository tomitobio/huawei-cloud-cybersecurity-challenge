# Keep the Docker build context small and free of secrets/artifacts.
**/node_modules
**/dist
**/build
**/coverage
**/*.log
coverage
.git
.github
.opencode

# Never bake real environment files into an image (keep the example).
**/.env
**/.env.local
**/.env.*.local

# Local database files
**/*.db
**/*.db-journal

# OS / editor noise
.DS_Store
